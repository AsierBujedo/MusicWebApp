# ---- General ----
APP_ENV=development
# Generate a strong secret for production: openssl rand -base64 48
SECRET_KEY=dev-insecure-change-me

# ---- Database ----
# SQLite for local dev. For production point at Postgres, e.g.:
# DATABASE_URL=postgresql+psycopg://user:pass@db:5432/homemusic
DATABASE_URL=sqlite:///./data/app.db

# ---- Sessions / cookies ----
SESSION_COOKIE_NAME=hm_session
SESSION_TTL_SECONDS=2592000

# ---- CORS ----
# The browser origin of the Next.js frontend when it is served from a DIFFERENT
# origin than this API (dev / preview). Leave EMPTY in production when the app is
# served same-origin behind a reverse proxy. When set, cookies become
# SameSite=None; Secure (HTTPS required). Comma-separate multiple origins.
FRONTEND_ORIGIN=http://localhost:3000

# ---- Integrations ----
# Master switch: true => run entirely on built-in mocks (no external services).
# Set to false to talk to the real DroppedNeedle / Navidrome / slskd below.
MOCK_EXTERNAL_SERVICES=true

# DroppedNeedle (acquisition orchestrator)
DROPPEDNEEDLE_URL=
DROPPEDNEEDLE_API_KEY=

# Navidrome (owned library, Subsonic API)
NAVIDROME_URL=
NAVIDROME_USERNAME=
NAVIDROME_PASSWORD=

# slskd (Soulseek daemon, download status)
SLSKD_URL=
SLSKD_API_KEY=

# ---- Background worker ----
# Seconds between polls that advance in-flight requests.
REQUEST_POLL_INTERVAL_SECONDS=10

# ---- Bootstrap admin ----
# Created only on first run when the users table is empty. In development this
# falls back to admin/admin if left blank; in production it is REQUIRED.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_DISPLAY_NAME=Admin
